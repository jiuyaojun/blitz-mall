# ============================================================
# Blitz 智能商城 — 环境变量配置
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ---- 数据库 ----
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# ---- Redis ----
REDIS_PASSWORD=your_redis_password_here

# ---- PostgreSQL (AI 向量数据库) ----
PG_USER=blitz
PG_PASSWORD=your_postgres_password_here

# ---- JWT 签名密钥 (至少 256 bits, 32 字符) ----
BLITZ_JWT_SECRET=your_jwt_secret_at_least_32_characters

# ---- AI (智谱 GLM-4-Flash) ----
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 可选 ----
# SPRING_PROFILES_ACTIVE=dev,ai
